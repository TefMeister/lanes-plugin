#!/usr/bin/env bash
# SessionStart hook: the handover light. Is everything on this PC on GitHub, and when did the other
# PC last save and how did it end? Three plain lines at the top of every session (tools/handover.py).
# Silent on every failure path: a hook that can be the reason a session opens with an error gets
# switched off within a week.
#
# LANES_HANDOVER=0 turns it off.
set -uo pipefail
[ "${LANES_HANDOVER:-1}" = "0" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TOOL="${PLUGIN_ROOT}/tools/handover.py"
EMIT="${SCRIPT_DIR}/emit_context.py"

[ -f "$TOOL" ] && [ -f "$EMIT" ] || exit 0
[ -f "${LANES_CONFIG:-$HOME/.claude/lanes.conf}" ] || exit 0   # the plugin is asleep on this PC

# Pick an interpreter that actually RUNS, not merely one that is on PATH: on Windows,
# python3 and python can be Store stubs that exist, print an advert and exit non-zero.
PY=""
for cand in python3 python py; do
  command -v "$cand" >/dev/null 2>&1 || continue
  "$cand" -c "" >/dev/null 2>&1 || continue
  PY="$cand"; break
done
[ -n "$PY" ] || exit 0

# Name THIS copy's tool by its real folder (2026-11-05). A session's shell has no CLAUDE_PLUGIN_ROOT, so sessions on
# both PCs guessed the folder, found an old copy in the plugin cache (0.100.0), ran its close-out, and that wrote
# "lanes = 0.100.0" into the board while 0.102.0 ran: the two-PC version line then believed it. The home folder is
# written as ~ (the command shows on screen while Tefa may be recording).
SHOWN="$TOOL"
case "$TOOL" in "$HOME"/*) SHOWN="~${TOOL#"$HOME"}";; esac
# 0.107.0: the light waits up to 50 s for its own fresh result and otherwise shows the last one with its age. Alone it
# takes about 20 s on the dev PC; in the start-up crowd it ran past its 90 s limit and the session got NO light at all
# (2026-11-10). The run itself carries on in the background either way (it also records this session's start), so
# --own: every window starts its own. LANES_BRIEF_WAIT_S changes the wait (the tests use a short one).
BASH_EXE="$BASH"; command -v cygpath >/dev/null 2>&1 && BASH_EXE="$(cygpath -w "$BASH")"
WAIT_S="${LANES_BRIEF_WAIT_S:-50}"
{
  # an earlier end left locks on GitHub? (endwork.py finish, 0.103.0), then the light itself
  # shellcheck disable=SC2016  # the single quotes are on purpose: bash -c fills $1 $2 $3 in
  "$PY" "${PLUGIN_ROOT}/tools/briefcache.py" show handover --own --wait-s="$WAIT_S" --max-age-h=12 -- \
    "$BASH_EXE" -c '"$1" "$2" finish 2>/dev/null; "$1" "$3" start --write 2>/dev/null' _ \
    "$PY" "${PLUGIN_ROOT}/tools/endwork.py" "$TOOL" 2>/dev/null
  echo "Every lane's write-up ends with the close-out box (python \"$SHOWN\" close - this session's own Lanes copy; never a copy found in the plugin cache), pasted unchanged under the gate/model box. NOT SAVED at the end of a session means: save first, then end."
} | "$PY" "$EMIT"
exit 0
