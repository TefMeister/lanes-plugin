{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" version-line",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Reading the Lanes version",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook session-name.py",
            "shell": "bash",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook start-bundle.py",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Loading the rules and reminders (one after another)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook start-bundle.py slow",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "Loading the reminders that read GitHub (one after another)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" board-brief",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Reading the board",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" handover-brief",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "Handover light: is everything on GitHub?",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" begone-ride",
            "shell": "bash",
            "timeout": 45,
            "statusMessage": "BeG0nE: starting the rider, reading new reports",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" builds-brief",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Checking this PC's app folders against the saved builds",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" games-brief",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking this PC's games against its record",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" theme-apply",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "First run: putting the plugin's look on the terminal",
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook inspector-hook.py",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Inspector: anything carried over?"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook compact-hook.py post",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Lanes: putting the checkpoint back in view"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" gd-shelve",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "Gold Digger: shelving logs from earlier runs",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook prompt-guards.py",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Lanes prompt checks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook tool-guards.py",
            "shell": "bash",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook end-work.py",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Handing this session's end steps to a helper that outlives the window"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook pd-guard.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook compact-hook.py end",
            "shell": "bash",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook clash-guard.py",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Clash guard: giving back this session's locks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook inspector-hook.py",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Inspector: looking over the edit"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook git-queue.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook compact-hook.py pre",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Lanes: saving a checkpoint before the summary"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" taskbar-flash",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" py-hook reply-check.py",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" taskbar-flash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
