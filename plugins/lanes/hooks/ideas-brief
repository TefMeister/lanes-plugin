#!/usr/bin/env bash
# SessionStart hook: if ideas are waiting in the ideas repo (lines in DUMP.md, or open issues),
# put that in front of the session so it files them first. Silent otherwise - and silent on every
# failure path, because a hook that can be the reason a session opens with an error gets switched
# off within a week. Needs `ideas = ...` in lanes.conf; with none set it says nothing.
#
# LANES_IDEAS_CHECK=0 turns it off.
set -uo pipefail
[ "${LANES_IDEAS_CHECK:-1}" = "0" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TOOL="${PLUGIN_ROOT}/tools/ideas.py"
EMIT="${SCRIPT_DIR}/emit_context.py"

[ -f "$TOOL" ] && [ -f "$EMIT" ] || exit 0

# Pick an interpreter that actually RUNS, not merely one that is on PATH: on Windows,
# python3 and python can be Store stubs that exist, print an advert and exit non-zero.
PY=""
for cand in python3 python py; do
  command -v "$cand" >/dev/null 2>&1 || continue
  "$cand" -c "" >/dev/null 2>&1 || continue
  PY="$cand"; break
done
[ -n "$PY" ] || exit 0

"$PY" "$TOOL" check 2>/dev/null | "$PY" "$EMIT"
exit 0
