#!/usr/bin/env bash
# SessionStart hook: if anything is queued for THIS machine and only this machine can do it,
# put it in front of the session. Silent otherwise - and silent on every failure path, because
# a hook that can be the reason a session opens with an error gets switched off within a week.
#
# LANES_OWED=0 turns it off.
set -uo pipefail
[ "${LANES_OWED:-1}" = "0" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
OWED="${PLUGIN_ROOT}/tools/owed.sh"
EMIT="${SCRIPT_DIR}/emit_context.py"

[ -f "$OWED" ] && [ -f "$EMIT" ] || exit 0

# Pick an interpreter that actually RUNS, not merely one that is on PATH: on Windows,
# python3 and python can be Store stubs that exist, print an advert and exit non-zero.
PY=""
for cand in python3 python py; do
  command -v "$cand" >/dev/null 2>&1 || continue
  "$cand" -c "" >/dev/null 2>&1 || continue
  PY="$cand"; break
done
[ -n "$PY" ] || exit 0

bash "$OWED" check 2>/dev/null | "$PY" "$EMIT"
exit 0
