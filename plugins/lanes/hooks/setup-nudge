#!/usr/bin/env bash
# SessionStart hook: the FIRST time the lanes plugin runs on a machine, put a one-line offer in
# front of the session to walk the user through the optional tools (/lanes:setup).
#
# Silent once the offer has been made here (the state file exists), when LANES_SETUP_NUDGE=0,
# and on every failure path - a session-start hook must never be the reason a session opens
# with an error.
set -uo pipefail
[ "${LANES_SETUP_NUDGE:-1}" = "0" ] && exit 0
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${LANES_STATE_DIR:-$HOME/.claude/lanes}"
PY=""
for cand in python3 python py; do
  command -v "$cand" >/dev/null 2>&1 || continue
  "$cand" -c "" >/dev/null 2>&1 || continue
  PY="$cand"; break
done

# 0.121.0: setup's recommended run leaves the steps that need the person in one list; say so every session until done
if [ -n "$PY" ] && [ -f "$STATE_DIR/setup-run.json" ]; then
  left=$("$PY" "$SCRIPT_DIR/../tools/setup_run.py" todo --count 2>/dev/null | tr -d '[:space:]')
  if [ -n "$left" ] && [ "$left" != "0" ]; then
    printf '%s
' "SETUP: $left step(s) from setup still need the person (sign-ins, clicks inside other programs, a restart). Say so in one line at the top of your first reply, in plain words, and offer to go through them: python \"\${CLAUDE_PLUGIN_ROOT}/tools/setup_run.py\" todo lists them; setup_run.py done <n> ticks one off." | "$PY" "$SCRIPT_DIR/emit_context.py"
    exit 0
  fi
fi
[ -f "$STATE_DIR/setup-state.json" ] && exit 0

MSG="FIRST RUN of the lanes plugin on this machine. Before other work, offer the user - in one short plain sentence - a guided setup: it first asks what name sessions should use for them in notes and on GitHub (until they choose, it is \"User\") and what to call this PC (until they choose, PC1, PC2 and so on), then whether to install the recommended set and leave it running (the steps that need them come in one list at the end) or go through everything one by one, then walks through the optional tools these lanes use (Git, Python, build tools, x64dbg and Ghidrust with their MCP servers, the RE Engine and UEVR live-game MCP servers, Blender + Blender MCP, gamepad and VR runtimes): they can type /lanes:setup, where each missing tool can be installed by Claude or downloaded by them from its official link, or skipped. If they decline, record it so this offer is not repeated: python \"\${CLAUDE_PLUGIN_ROOT}/tools/setup-scan.py\" --mark-done"
if [ -n "$PY" ]; then
  printf '%s\n' "$MSG" | "$PY" "$SCRIPT_DIR/emit_context.py"
else
  # No working Python: emit the plain payload by hand (the message has no characters needing escapes beyond quotes).
  esc=${MSG//\/\\}; esc=${esc//\"/\\\"}
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}' "$esc"
fi
exit 0
