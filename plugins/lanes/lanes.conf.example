# lanes.conf - copy to ~/.claude/lanes.conf and edit.
#
# Everything here is optional. Anything you leave out falls back to an
# environment variable, then to a sensible default. Values may be quoted;
# trailing whitespace and CRLF line endings are tolerated.

# WHAT SESSIONS CALL YOU.
# In anything a session saves or publishes - notes, boards, commit messages,
# READMEs - you are "User" unless you set a name here. Your real name, login,
# e-mail, machine names and home-folder paths are never written, whatever you
# set. /lanes:setup asks for this; tools/display-name.py sets it too.
# Letters, digits, spaces and . _ - only, up to 40 characters.
# display_name = User

# WHERE THE BOARD IS.
# The board is an ordinary git repo with a status/ folder holding one
# <project>.md per project. Make it PRIVATE: it is your working notes.
# Overridden by $LANES_BOARD, and by a path passed on the command line.
board = /path/to/your/board-repo

# WHAT THIS MACHINE IS.
# Any label you like, as long as it matches the first column of
# machine-assignments.tsv in the board repo. The shipped example uses
# HOME (the one with the special hardware) and DEV (everything else).
# Overridden by $GATE_ROLE. Defaults to DEV.
role = DEV

# WHAT THIS PC IS CALLED in claims and reminders (0.24.0).
# Never the computer's real name. /lanes:setup asks; if you pick nothing it is
# PC1, PC2 and so on, whichever is free on the board. Letters, digits and
# . _ - only. Change it with tools/machine-name.py set <name>.
# machine_name = PC1

# WHERE YOUR CLONES LIVE - used by /gs, which sweeps all of them, and by
# root-sync.sh, which keeps every lane's clone root holding every repo.
# One folder holding every repo as a subfolder. Overridden by $LANES_ROOT,
# and by a path passed to gs-scan.sh. If unset, gs-scan uses the current
# directory when that directory actually holds clones.
# root = /path/to/folder-holding-your-clones

# THE LANE ROOTS, if they are not simply <root>-pd, <root>-gr, <root>-sr and
# <root>-gs next to it (those are found automatically). Comma- or space-separated.
# lane_roots = /path/to/clones-pd, /path/to/clones-gr

# THE BOARD'S FOLDER NAME inside that root. Defaults to the basename of
# `board` above, so you normally do not need this.
# board_dir = board-repo

# YOUR PUBLIC FRONT PAGE, if you have one.
# The file people land on - a profile README, a landing page. Every session is
# expected to add a dated line to it, whether or not anything advanced: a dead
# end or a correction keeps the page honest, and a page that only moves on good
# news reads as a press release. frontpage-scan.sh warns when it falls behind
# the boards; it never writes the entry for you.
# Overridden by $LANES_FRONTPAGE. Unset means the check stays quiet.
# frontpage = /path/to/profile-repo/README.md

# YOUR IDEAS REPO, if you keep one (0.23.0).
# A private repo where ideas are written down as they come (DUMP.md) and then
# filed by /lanes:ideas. template-ideas/ in the plugin is a ready-made one.
# With this set, a session-start check files waiting ideas before other work,
# and /pd and /lm open each project with its fresh ideas as a numbered list.
# Overridden by $LANES_IDEAS. Unset means the check stays quiet.
# ideas = /path/to/your-ideas-repo
#
# Projects never offered ideas from a page marked `*` (frozen or archived).
# ideas_skip = old-project another-old-project

# KEEP EVERY BUILD (0.26.0).
# A clone of a PRIVATE repo where every change you install is saved as its own
# numbered version (tools/builds.py), and pushed so every PC has the same ones.
# Overridden by $LANES_BUILDS. Unset means builds.py does nothing.
# With it set, every session start checks this PC's app folders against the
# saved builds and speaks up only when one has drifted (0.28.0).
# builds = /path/to/your-builds-repo
#
# The app folder of a project ON THIS PC, when it differs from the one in that
# project's PROJECT.conf (a different drive or Steam library, say).
# builds_app.my-project = /path/to/the/app

# SESSION LOGS (0.44.0): every session's write-up is saved here, one folder per project, one dated file
# per summary (tools/session-log.py). If the folder is a git clone, each new file is committed and pushed.
# Keep that repo PRIVATE. Unset means nothing is kept.
# session_logs = /path/to/your-session-logs-repo

# HOW MANY REPOS THAT ROOT SHOULD HOLD.
# /gs prints a loud PARTIAL ESTATE banner when it finds fewer, because a
# hygiene tool that silently understates is worse than no hygiene tool.
# Unset means the banner never fires - set it once your estate has a
# stable size.
# expected_repos = 22

# THE INSPECTOR (0.37.0, docs/PROTOCOL.md section 16). Off unless this says on.
# After every code edit it notes anything messy in the project's notes folder;
# saves always go through, but git push waits until every note is answered.
# inspector = on
# inspector_home = /folder/for/its/backups        (default ~/.claude/lanes-inspector)
# inspector_mode = end        (default: answer the notes at the end; `each` = after every edit)
# inspector_repos = project-a, project-b          (limit it to these; unset = every repo)
# inspector_root = /your/clone/root               (where it looks for code copied between projects)
# inspector_notes_local = on  (keep the notes on this PC only, never committed; for public repos)
# inspector_multi = staging   (repos that hold one folder per project; notes kept per folder)

# THE PLUGIN'S LOOK (0.41.0).
# The first session after installing puts the green-monitor-lanes style on the
# Windows Terminal profile it runs in, once, with a backup; /lanes:theme restore
# undoes it. Set this to off on a PC where that is not wanted. $LANES_THEME=0 too.
# theme = off

# The desktop shortcut named Lanes (0.53.0): once the look is on, the next session offers it
# once; /lanes:theme shortcut makes one any time. Set this to off to never be offered. $LANES_SHORTCUT=0 too.
# shortcut = off

# NEW GITHUB REPOS ARE PRIVATE (0.58.0). Every repo a session creates is private, and the session asks you
# first whether any of the ones it is about to create should be public. A public one always needs your OK.
# Set this to public if you want new repos public by default. $LANES_NEW_REPOS=public too.
# new_repos = public

# THE TRANSFER FOLDER (0.47.0).
# A folder kept in step between your PCs by a sync app (MEGA suggested; /lanes:setup offers the steps).
# Sessions save here what must reach the other PC but must never go on GitHub, sorted into
# Videos\ (recordings) and Game Files\<project>\ (app files, extracted assets, big builds).
# For your own PCs only: sharing game files with other people is illegal.
# transfer = /path/to/your/transfer/folder

# BEG0NE TOOLS (0.52.0; shipped in the plugin since 0.62.0).
# The jitter recorder, Ghost Hand and the occlusion drift fix come with Lanes (begone/), and their rider
# starts with every session. It idles until a VR mod wired to one of them runs a headset session, then
# turns the recording into a short report. This setting says WHERE the reports are kept: a clone of the
# BeG0nE repo (github.com/TefMeister/BeG0nE) puts them on GitHub for your other PC; unset, they go to
# Documents\BeG0nE recordings. Overridden by $LANES_BEGONE.
# begone = /path/to/your/BeG0nE-clone

# THE WEEKLY TOOL CHECK, /lanes:gu (0.67.0, PROTOCOL section 23). Each line may repeat.
#   twin   = <master copy> | <second copy>   two copies of the same tool (file or folder) that must match
#   watch  = <name> | <owner/repo>           someone else's tool on GitHub: say when a new release is out
#   ours   = <clone>                         one of our own tool repos: behind or ahead of GitHub?
#   routes = <folder>                        where each app's routes and KNOWN.md live (its Tool ideas are read)
#   gu_ask = no                              update without asking first (default: one question for everything)
# Many tools publish real updates as nightly builds on a separate repo (praydog/UEVR-nightly,
# praydog/REFramework-nightly); watch that one when the main page's releases are years old.
# twin = /path/to/toolkit/tools/menu-o-matic | /path/to/lanes-plugin/plugins/lanes/tools/menu-o-matic
# watch = UEVR | praydog/UEVR

# KEEP CONVERSATIONS SHORT (0.63.0, PROTOCOL section 21).
# Claude Code summarises a conversation by itself when it is nearly full. `tools/compact.py on` moves that
# earlier, to this share of the model's room (10 to 95; default 40), by writing one setting into
# ~/.claude/settings.json (backed up first). Before every summary Lanes saves a checkpoint to the session logs
# and tells the summary what must survive. `off` here means /lanes:setup never offers it; the close-out box
# then says when it is safe to /clear instead.
# early_summary = 40
#
# Where full conversation logs are copied, so Claude Code's 30-day clean-up never removes them.
# Default ~/.claude/lanes-transcripts. They can hold anything said in a session: keep them on this PC.
# transcripts = /path/to/kept/conversation/logs

# Where the OpenXR Simulator lives on this PC, when it is not in the default folder (%LOCALAPPDATA%\Programs\
# OpenXR-Simulator) and not registered with Windows (0.73.0). tools/openxr-sim.py finds and updates it there.
# openxr_sim = <folder>
#
# VR Bench (0.74.0), which plays a VR game for you through the simulator. Set by /lanes:setup; change by hand any time.
# bench_headset = real | none   (can a real VR headset be worn on this PC? set by /lanes:setup)
# bench_tier = light | full     (VR Bench's strength; chosen from the PC's specs when unset)
# bench_footage_warn_gb = 20    (say so when VR Bench's footage passes this many GB; nothing is deleted on its own)
# vrbench_exe.<project> = <path to the game's program>   (when its builds_app folder holds more than one)
